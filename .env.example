# =============================================================
# main.py (advisory-only: reads Fidelity via Plaid, texts you, never trades)
# =============================================================
PLAID_CLIENT_ID=
PLAID_SECRET=
# "sandbox" while testing, "development" or "production" for your real Fidelity account
PLAID_ENV=sandbox
# Obtained once via scripts/plaid_link.py after you complete the Plaid Link flow
PLAID_ACCESS_TOKEN=

# =============================================================
# auto_trade.py (fully automated: trades a funded Alpaca account directly)
# =============================================================
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true = paper trading (simulated money). Keep this true until you've
# reviewed weeks of unattended paper-trading behavior.
ALPACA_PAPER=true
# Symbols auto_trade.py may open NEW positions in (comma-separated).
# Existing Alpaca positions are always evaluated for SELL regardless.
WATCHLIST_SYMBOLS=AAPL,MSFT,SPY

# Position size on a new BUY scales with that signal's conviction score
# (trend + momentum strength + RSI headroom), between these two bounds of
# account equity -- not a flat percentage.
MIN_POSITION_SIZE_PCT=0.02
MAX_POSITION_SIZE_PCT=0.10
# Kill switch: stop placing new orders once today's account drawdown hits
# this fraction (0.03 = 3%). You get texted instead.
MAX_DAILY_LOSS_PCT=0.03
# Trailing stop: sell a held position once price pulls back this fraction
# from its peak since purchase (0.08 = 8%), even if the trend hasn't
# reversed yet. Lets winners run while still climbing.
TRAILING_STOP_PCT=0.08

# Screener: scan the S&P 500 for new BUY candidates beyond WATCHLIST_SYMBOLS.
# Off by default -- turn on only once you trust the watchlist-only behavior.
SCREENER_ENABLED=false
# Cap on brand-new positions the screener can open in a single run.
MAX_NEW_SCREENER_POSITIONS=3

# --- Alpha Vantage (price history for indicators, used only by main.py) ---
ALPHAVANTAGE_API_KEY=

# --- Twilio (SMS delivery) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# --- Strategy tuning (optional, these are the defaults) ---
SMA_FAST=20
SMA_SLOW=50
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# Where signal state is persisted between runs
STATE_FILE=state.json
